#!/bin/bash
build_flame1_command() {
    local cmd="$1"
    local token out skip_next
    local -a tokens

    cmd="${cmd/--runmode=flame12/--runmode=flame1}"
    out=""
    skip_next=0

    # FEAT-generated flameo commands are whitespace-delimited. Keep this simple
    # so the fallback does not evaluate command text while rewriting options.
    read -r -a tokens <<< "$cmd"
    for token in "${tokens[@]}"; do
        if [ "$skip_next" -eq 1 ]; then
            skip_next=0
            continue
        fi
        case "$token" in
            --nj|--bi|--se|--zlt|--zut)
                skip_next=1
                ;;
            --nj=*|--bi=*|--se=*|--zlt=*|--zut=*|--fm)
                ;;
            *)
                out="${out}${out:+ }${token}"
                ;;
        esac
    done

    printf '%s\n' "$out"
}

extract_ld_dir() {
    local cmd="$1"
    local token next_is_ld
    local -a tokens

    next_is_ld=0
    read -r -a tokens <<< "$cmd"
    for token in "${tokens[@]}"; do
        if [ "$next_is_ld" -eq 1 ]; then
            printf '%s\n' "$token"
            return 0
        fi
        case "$token" in
            --ld)
                next_is_ld=1
                ;;
            --ld=*)
                printf '%s\n' "${token#--ld=}"
                return 0
                ;;
        esac
    done
    return 1
}

move_failed_ld_dir() {
    local cmd="$1"
    local ld failed_ld

    ld="$(extract_ld_dir "$cmd")" || return 0
    if [ -z "$ld" ] || [ ! -d "$ld" ]; then
        return 0
    fi

    # FEAT merges stats*/ images after slicing. Keep failed images outside that glob.
    failed_ld="$(command -p dirname "$ld")/.flame12_failed.${ld##*/}.$$"
    if /bin/mv "$ld" "$failed_ld" 2>/dev/null; then
        echo "flame_runner: moved failed FLAME12 log directory to ${failed_ld}" >&2
        printf '%s\n' "$failed_ld"
    else
        /bin/rm -rf "$ld"
        printf '%s\n' "$ld"
    fi
}

# Preserve the original six-column format for consumers of an external log.
legacy_header='timestamp_utc\tpid\tflame12_status\tld_dir\tfailed_ld_dir\tfallback_command'
append_external_log() {
    local log_file="$1"
    if [[ ! -s "$log_file" ]]; then printf '%b\n' "$legacy_header" > "$log_file" || return 1; fi
    command -p cut -f1-6 >> "$log_file"
}

log_flame12_fallback() {
    local status="$1"
    local ld="$2"
    local failed_ld="$3"
    local fallback="$4"
    local fallback_status="$5"
    local record row
    printf -v row '%s\t%s\t%s\t%s\t%s\t%s\t%s' \
        "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')" "$$" "$status" "${ld:-NA}" \
        "${failed_ld:-NA}" "$fallback" "$fallback_status"
    if [[ -n "${FLAME_RUNNER_RECORD_DIR:-}" ]]; then
        record=$(command -p mktemp "$FLAME_RUNNER_RECORD_DIR/row.XXXXXXXX") || return 1
        printf '%s\n' "$row" > "$record"
    else
        # Direct --run-command invocations have no batch audit.
        append_external_log "${FLAME_RUNNER_FALLBACK_LOG:-flame_runner_fallbacks.tsv}" <<< "$row"
    fi
}

run_flame_command() {
    local cmd="$1"
    local status fallback ld failed_ld

    sh -c "$cmd"
    status=$?
    if [ "$status" -eq 0 ]; then
        return 0
    fi

    if [[ "$cmd" == *"--runmode=flame12"* ]]; then
        fallback="$(build_flame1_command "$cmd")"
        echo "flame_runner: FLAME12 slice command failed with status ${status}; retrying with FLAME1: ${fallback}" >&2
        ld="$(extract_ld_dir "$cmd")"
        failed_ld="$(move_failed_ld_dir "$cmd")"
        sh -c "$fallback"
        local fallback_status=$?
        log_flame12_fallback "$status" "$ld" "$failed_ld" "$fallback" "$fallback_status" || return 1
        return "$fallback_status"
    fi

    return "$status"
}

if [ "${1:-}" = "--run-command" ]; then
    shift
    if [ $# -ne 1 ]; then
        echo "flame_runner: --run-command expects one command string" >&2
        exit 1
    fi
    run_flame_command "$1"
    exit $?
fi

if [ $# -ne 2 ]; then
    echo "flame_runner expects two arguments: <list of flame commands> <max jobs>"
    exit 1
fi

flame_list="$1"
njobs="$2"

if [ ! -f "$flame_list" ]; then
    echo "flame_runner: command list not found: $flame_list"
    exit 1
fi

if ! [[ "$njobs" =~ ^[0-9]+$ ]]; then
    echo "flame_runner: max jobs must be a positive integer (got: $njobs)"
    exit 1
fi

detect_alloc() {
    local v
    for v in "${SLURM_CPUS_PER_TASK:-}" "${SLURM_NTASKS:-}" "${SLURM_CPUS_ON_NODE:-}" "${PBS_NP:-}" "${NCPUS:-}" "${PBS_NUM_PPN:-}"; do
        if [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -gt 0 ]; then
            echo "$v"
            return 0
        fi
    done
    return 1
}

alloc="$(detect_alloc)"
if [ -n "$alloc" ] && [ "$alloc" -gt 0 ] && [ "$njobs" -gt "$alloc" ]; then
    njobs="$alloc"
fi

nslices=$(grep -cve '^[[:space:]]*$' "$flame_list")
if [ "$nslices" -le 0 ]; then
    echo "flame_runner: no commands found in $flame_list"
    exit 1
fi
if [ "$njobs" -gt "$nslices" ]; then
    njobs="$nslices"
fi
if [ "$njobs" -le 0 ]; then
    njobs=1
fi

# Each child owns one fallback record. Only the parent writes the shared TSV.
list_dir=$(command -p dirname "$flame_list")
audit="$list_dir/flame_runner_fallbacks.tsv"
FLAME_RUNNER_RECORD_DIR=$(command -p mktemp -d "$list_dir/.flame_records.XXXXXXXX") || exit 1
export FLAME_RUNNER_RECORD_DIR
trap 'command -p rm -rf "$FLAME_RUNNER_RECORD_DIR"' EXIT

cmd_parallel=$(command -v parallel)
cmd_xargs=$(command -v xargs)

has_parallel=0
has_xargs=0
xargs_supports_d=0

[ -n "$cmd_parallel" ] && has_parallel=1
[ -n "$cmd_xargs" ] && has_xargs=1

if [ "$has_xargs" -eq 1 ]; then
    if "$cmd_xargs" --help 2>&1 | grep -q -- '-d'; then
        xargs_supports_d=1
    fi
fi

if [ "$has_parallel" -eq 1 ]; then
    "$cmd_parallel" --jobs "$njobs" "$0" --run-command {} < "$flame_list"
    status=$?
elif [ "$has_xargs" -eq 1 ] && [ "$xargs_supports_d" -eq 1 ]; then
    "$cmd_xargs" -d '\n' -n 1 -P "$njobs" "$0" --run-command < "$flame_list"
    status=$?
else
    # macOS system Bash lacks wait -n. Join the recorded PIDs before
    # publishing the audit, including children that have already finished.
    pids=()
    status=0
    while IFS= read -r line; do
        if [ -z "${line//[[:space:]]/}" ]; then
            continue
        fi
        if (( ${#pids[@]} >= njobs )); then
            wait "${pids[0]}" || status=1
            pids=("${pids[@]:1}")
        fi
        run_flame_command "$line" &
        pids+=("$!")
    done < "$flame_list"
    for pid in "${pids[@]}"; do
        wait "$pid" || status=1
    done
fi

# A header-only audit records a completed run with zero slice fallbacks.
header="${legacy_header}\tfallback_status"
printf '%b\n' "$header" > "$FLAME_RUNNER_RECORD_DIR/audit" || exit 1
shopt -s nullglob
rows=("$FLAME_RUNNER_RECORD_DIR"/row.*)
if (( ${#rows[@]} )); then
    command -p cat "${rows[@]}" >> "$FLAME_RUNNER_RECORD_DIR/audit" || exit 1
fi
command -p mv "$FLAME_RUNNER_RECORD_DIR/audit" "$audit" || exit 1
# Preserve the optional external log while retaining an audit specific to this fit.
if [[ -n "${FLAME_RUNNER_FALLBACK_LOG:-}" && ! "$audit" -ef "$FLAME_RUNNER_FALLBACK_LOG" && ${#rows[@]} -gt 0 ]]; then
    command -p cat "${rows[@]}" | append_external_log "$FLAME_RUNNER_FALLBACK_LOG" || exit 1
fi
exit "$status"
